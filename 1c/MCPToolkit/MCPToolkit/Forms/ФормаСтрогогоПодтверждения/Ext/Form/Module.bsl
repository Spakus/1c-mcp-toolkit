#Область ОбработчикиСобытийФормы

// Заполняет реквизиты формы из параметров и настраивает вид под режим открытия.
//
// Параметры:
//  Отказ - Булево - признак отказа от создания формы.
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Инструмент = ЗначениеПараметра("Инструмент", "");
	ТекстКПодтверждению = ЗначениеПараметра("ТекстКПодтверждению", "");
	ТекстРаспознан = ЗначениеПараметра("ТекстРаспознан", Истина);
	Причины = ЗначениеПараметра("Причины", "");
	Риски = ЗначениеПараметра("Риски", "");
	КлассЗащиты = ЗначениеПараметра("КлассЗащиты", Ложь);
	Обоснование = ЗначениеПараметра("Обоснование", "");
	ОсталосьСекунд = ЗначениеПараметра("ТаймаутСек", 0);
	Режим = ЗначениеПараметра("Режим", "gate");

	Элементы.ДекорацияКлассЗащиты.Видимость = КлассЗащиты;
	Элементы.ДекорацияТекстНеРаспознан.Видимость = Не ТекстРаспознан;
	Элементы.ПолеПричины.Видимость = Не ПустаяСтрока(Причины);
	Элементы.ПолеРиски.Видимость = Не ПустаяСтрока(Риски);
	Элементы.ПолеОбоснование.Видимость = Не ПустаяСтрока(Обоснование);
	Элементы.ПолеОсталосьСекунд.Видимость = ОсталосьСекунд > 0;
	НастроитьПодписиПоРежиму();

КонецПроцедуры

// Запускает обратный отсчет до автоматического отклонения.
//
// Параметры:
//  Отказ - Булево - признак отказа от открытия формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если ОсталосьСекунд > 0 Тогда

		ПодключитьОбработчикОжидания("ТикТаймаута", 1, Ложь);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Закрывает форму с решением "подтверждено".
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
&НаКлиенте
Процедура Подтвердить(Команда)

	Закрыть("approved");

КонецПроцедуры

// Закрывает форму с решением "отклонено".
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
&НаКлиенте
Процедура Отклонить(Команда)

	Закрыть("rejected");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Уменьшает остаток времени и закрывает форму с решением "timeout" по его исчерпании.
&НаКлиенте
Процедура ТикТаймаута() Экспорт

	ОсталосьСекунд = ОсталосьСекунд - 1;

	Если ОсталосьСекунд <= 0 Тогда

		ОтключитьОбработчикОжидания("ТикТаймаута");
		Закрыть("timeout");

	КонецЕсли;

КонецПроцедуры

// Возвращает значение параметра формы или значение по умолчанию.
//
// Параметры:
//  Имя - Строка - имя параметра формы.
//  ПоУмолчанию - Произвольный - значение, если параметр не передан.
//
// Возвращаемое значение:
//  Произвольный - значение параметра.
//
&НаСервере
Функция ЗначениеПараметра(Имя, ПоУмолчанию)

	Значение = Неопределено;

	Если Параметры.Свойство(Имя, Значение) И Значение <> Неопределено Тогда

		Возврат Значение;

	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

// Задает заголовок формы и подписи кнопок по режиму открытия.
&НаСервере
Процедура НастроитьПодписиПоРежиму()

	Если Режим = "restore_trust" Тогда

		Заголовок = "Восстановление доверия к данным";
		Элементы.КнопкаПодтвердить.Заголовок = "Восстановить доверие";

	ИначеЕсли Режим = "open_link" Тогда

		Заголовок = "Открытие внешней ссылки";
		Элементы.КнопкаПодтвердить.Заголовок = "Открыть ссылку";

	Иначе

		Заголовок = "Подтверждение действия в строгом режиме";
		Элементы.КнопкаПодтвердить.Заголовок = "Выполнить";

	КонецЕсли;

	Элементы.КнопкаОтклонить.Заголовок = "Отклонить";

КонецПроцедуры

#КонецОбласти
