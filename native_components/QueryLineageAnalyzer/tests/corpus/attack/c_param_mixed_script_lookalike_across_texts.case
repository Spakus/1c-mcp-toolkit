// kind: code
// expect: confirm
// reason: Q_PARSE_MIXED_SCRIPT
А = Новый Запрос("ВЫБРАТЬ &ВидA КАК Первый");
А.УстановитьПараметр("ВидA", "1");
Б = Новый Запрос("ВЫБРАТЬ &ВидA КАК Первый, &ВидА КАК Второй");
Б.УстановитьПараметр("ВидA", "1");
Б.УстановитьПараметр("ВидА", "2");
Результат = Б.Выполнить().Выгрузить();
