// kind: code
// expect: safe
// pending: C_UNKNOWN_METHOD: ТаблицаЗначений.Сортировать with a literal column list is not modelled.
З = Новый Запрос;
З.Текст =
"ВЫБРАТЬ
|    Реализация.Ссылка КАК Объект,
|    Реализация.Номер КАК Номер,
|    Реализация.Контрагент КАК Контрагент
|ИЗ
|    Документ.Реализация КАК Реализация
|ГДЕ
|    Реализация.Дата >= &П";
З.УстановитьПараметр("П", Дата(2020, 1, 1));
Таблица = З.Выполнить().Выгрузить();
Таблица.Сортировать("Номер");
Результат = Таблица;
