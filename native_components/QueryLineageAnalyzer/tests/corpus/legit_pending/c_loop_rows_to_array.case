// kind: code
// expect: safe
// label: $ = container
// label: $[*].Номер = open
// pending: C_UNLABELED_RESULT: a scalar read of an open column without reference targets is labelled unknown.
З = Новый Запрос;
З.Текст =
"ВЫБРАТЬ
|    Реализация.Ссылка КАК Объект,
|    Реализация.Номер КАК Номер,
|    Реализация.Контрагент КАК Контрагент
|ИЗ
|    Документ.Реализация КАК Реализация
|ГДЕ
|    Реализация.Дата >= &П";
З.УстановитьПараметр("П", Дата(2020, 1, 1));
Выборка = З.Выполнить().Выбрать();
Результат = Новый Массив;
Пока Выборка.Следующий() Цикл
    Результат.Добавить(Новый Структура("Объект, Номер", Выборка.Объект, Выборка.Номер));
КонецЦикла;
